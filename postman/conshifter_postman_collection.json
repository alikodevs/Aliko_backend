{
	"info": {
		"_postman_id": "conshifter-api-collection",
		"name": "Conshifter API",
		"description": "API collection for Conshifter microservice integrated via API Gateway.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Events",
			"item": [
				{
					"name": "Get All Events",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/conshifter/events",
							"host": ["{{base_url}}"],
							"path": ["conshifter", "events"]
						}
					}
				},
				{
					"name": "Create Event (Admin)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "title", "value": "Tech Summit 2024", "type": "text" },
								{ "key": "slug", "value": "tech-summit-2024", "type": "text" },
								{ "key": "description", "value": "Annual tech conference", "type": "text" },
								{ "key": "eventType", "value": "CONFERENCE", "type": "text" },
								{ "key": "startDate", "value": "2024-10-01T09:00:00Z", "type": "text" },
								{ "key": "isVirtual", "value": "true", "type": "text" },
								{ "key": "image", "type": "file", "src": [] }
							]
						},
						"url": {
							"raw": "{{base_url}}/conshifter/admin/events",
							"host": ["{{base_url}}"],
							"path": ["conshifter", "admin", "events"]
						}
					}
				}
			]
		},
