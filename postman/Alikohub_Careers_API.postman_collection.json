{
  "info": {
    "name": "AlikoHub Careers Platform API",
    "description": "Postman collection exactly reflecting the frontend API operations for Alikohub Careers Services.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3006", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Login",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "raw", "raw": "{\"email\":\"admin@alikohub.com\",\"password\":\"securepassword\"}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/auth/login", "host": [ "{{base_url}}" ], "path": [ "auth", "login" ] }
          }
        },
        {
          "name": "2. Register",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "raw", "raw": "{\"email\":\"newuser@alikohub.com\",\"password\":\"securepass\",\"fullName\":\"New User\"}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/auth/register", "host": [ "{{base_url}}" ], "path": [ "auth", "register" ] }
          }
        },
        {
          "name": "3. Logout",
          "request": {
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ] },
            "method": "POST",
            "header": [],
            "url": { "raw": "{{base_url}}/auth/logout", "host": [ "{{base_url}}" ], "path": [ "auth", "logout" ] }
          }
        }
      ]
    },
    {
