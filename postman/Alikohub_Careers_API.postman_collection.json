            "method": "PATCH",
            "header": [],
            "body": { "mode": "raw", "raw": "{\"title\":\"Senior Software Engineer\"}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/careers/jobs/1", "host": [ "{{base_url}}" ], "path": [ "careers", "jobs", "1" ] }
          }
        },
        {
          "name": "Apply To Job",
          "request": {
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ] },
            "method": "POST",
            "header": [],
            "body": { "mode": "formdata", "formdata": [ { "key": "resume", "type": "file" }, { "key": "coverLetter", "value": "I am a great fit.", "type": "text" } ] },
            "url": { "raw": "{{base_url}}/careers/jobs/1/apply", "host": [ "{{base_url}}" ], "path": [ "careers", "jobs", "1", "apply" ] }
