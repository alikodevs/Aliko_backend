      "item": [
        {
          "name": "Get All Jobs",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/careers/jobs", "host": [ "{{base_url}}" ], "path": [ "careers", "jobs" ] } }
        },
        {
          "name": "Get Job by ID",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/careers/jobs/1", "host": [ "{{base_url}}" ], "path": [ "careers", "jobs", "1" ] } }
        },
        {
          "name": "Creates Job",
          "request": {
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ] },
            "method": "POST",
            "header": [],
            "body": { "mode": "raw", "raw": "{\"title\":\"Software Engineer\",\"description\":\"Job Description...\",\"companyId\":\"COMPANY_ID\"}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/careers/jobs", "host": [ "{{base_url}}" ], "path": [ "careers", "jobs" ] }
          }
