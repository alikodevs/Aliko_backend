{
  "compileOnSave": false,
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "strictPropertyInitialization": false,
    "useUnknownInCatchVariables": false,
    "baseUrl": ".",
    "paths": {
      "@workspace/config": ["libs/config/src/index.ts"],
      "@workspace/common": ["libs/common/src/index.ts"],
      "@workspace/logger": ["libs/logger/src/index.ts"],
      "@workspace/database": ["libs/database/src/index.ts"],
      "@workspace/event-bus": ["libs/event-bus/src/index.ts"],
      "@workspace/auth": ["libs/auth/src/index.ts"],
      "@workspace/cache": ["libs/cache/src/index.ts"],
      "@workspace/storage": ["libs/storage/src/index.ts"],
      "@workspace/localization": ["libs/localization/src/index.ts"],
      "@workspace/websocket": ["libs/websocket/src/index.ts"],
      "@workspace/scheduler": ["libs/scheduler/src/index.ts"],
      "@workspace/contracts": ["libs/contracts/src/index.ts"],
      "@workspace/sms": ["libs/sms/src/index.ts"],
      "@aliko/config": ["libs/config/src/index.ts"],
      "@aliko/common": ["libs/common/src/index.ts"],
      "@aliko/logger": ["libs/logger/src/index.ts"],
      "@aliko/database": ["libs/database/src/index.ts"],
      "@aliko/event-bus": ["libs/event-bus/src/index.ts"],
      "@aliko/auth": ["libs/auth/src/index.ts"],
      "@aliko/cache": ["libs/cache/src/index.ts"],
      "@aliko/storage": ["libs/storage/src/index.ts"],
      "@aliko/localization": ["libs/localization/src/index.ts"],
      "@aliko/websocket": ["libs/websocket/src/index.ts"],
      "@aliko/scheduler": ["libs/scheduler/src/index.ts"],
      "@aliko/contracts": ["libs/contracts/src/index.ts"],
      "@aliko/sms": ["libs/sms/src/index.ts"],
      "@alikohub/logger": ["libs/logger/src/index.ts"],
      "@alikohub/common": ["libs/common/src/index.ts"],
      "@alikohub/config": ["libs/config/src/index.ts"],
      "@alikohub/database": ["libs/database/src/index.ts"],
      "@alikohub/auth": ["libs/auth/src/index.ts"],
      "@alikohub/auth-client": ["libs/auth/src/index.ts"],
      "@alikohub/storage": ["libs/storage/src/index.ts"],
      "@alikohub/cloudinary": ["libs/storage/src/index.ts"],
      "@alikohub/mail": ["libs/mail/src/index.ts"],
      "@aliko/mail": ["libs/mail/src/index.ts"],
      "@alikohub/notification": ["libs/notification/src/index.ts"],
      "@alikohub/chat": ["libs/chat/src/index.ts"],
      "@alikohub/file-upload-client": ["libs/file-upload-client/src/index.ts"],
      "@alikohub/payment-client": ["libs/payment-client/src/index.ts"],
      "@alikohub/firebase-admin": ["libs/firebase-admin/src/index.ts"],
      "@alikohub/rabbitmq": ["libs/event-bus/src/index.ts"],
      "@alikohub/*": ["libs/*/src/index.ts"],
      "@prisma/client/user": ["node_modules/@prisma/client/user"],
      "@prisma/client/academy": ["node_modules/@prisma/client/academy"],
      "@prisma/client/financial": ["node_modules/@prisma/client/financial"],
      "@prisma/client/contech": ["node_modules/@prisma/client/contech"],
      "@prisma/client/events": ["node_modules/@prisma/client/events"],
      "@prisma/client/careers": ["node_modules/@prisma/client/careers"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist", "**/*.spec.ts", "**/*.test.ts"]
}
