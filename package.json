{
  "name": "alikohub-reimplementation",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "main": "start-all.js",
  "scripts": {
    "start:dev:gateway": "nx serve api-gateway",
    "start:dev:user": "nx serve user-service",
    "start:dev:academy": "nx serve academy-service",
    "start:dev:contech": "nx serve contech-service",
    "start:dev:events": "nx serve events-service",
    "start:dev:careers": "nx serve careers-service",
    "start:dev:financial": "nx serve financial-service",
    "start:dev:communication": "nx serve communication-service",
    "start:dev:storage": "nx serve storage-service",
    "start:all": "node start-all.js",
    "build:all": "nx run-many --target=build --all",
    "test:all": "nx run-many --target=test --all",
    "lint:all": "nx run-many --target=lint --all",
    "start": "node start-all.js",
    "dev": "node start-all.js",
    "infra:up": "docker compose up -d",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prisma:generate:user": "prisma generate --schema=apps/user-service/prisma/schema.prisma",
    "prisma:generate:academy": "prisma generate --schema=apps/academy-service/prisma/schema.prisma",
    "prisma:generate:financial": "prisma generate --schema=apps/financial-service/prisma/schema.prisma",
    "prisma:generate:contech": "prisma generate --schema=apps/contech-service/prisma/schema.prisma",
    "prisma:generate:events": "prisma generate --schema=apps/events-service/prisma/schema.prisma",
    "prisma:generate:careers": "prisma generate --schema=apps/careers-service/prisma/schema.prisma",
    "prisma:generate:all": "npm run prisma:generate:user && npm run prisma:generate:academy && npm run prisma:generate:financial && npm run prisma:generate:contech && npm run prisma:generate:events && npm run prisma:generate:careers",
    "seed:admin": "ts-node -r dotenv/config apps/user-service/src/seed_test_users.ts",
    "seed:users": "ts-node -r dotenv/config apps/user-service/src/seed_test_users.ts",
    "postman:generate": "node update_postman_collection.js",
    "test:endpoints": "node tests/test_all_endpoints.js",
    "test:integration": "node tests/test_service_integration.js",
    "deploy": "bash scripts/deploy.sh",
    "deploy:pm2": "pm2 start ecosystem.config.cjs --update-env && pm2 save"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.6",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/platform-socket.io": "^11.2.6",
    "@nestjs/swagger": "^11.0.6",
    "@nestjs/websockets": "^11.2.6",
    "@prisma/client": "^6.15.0",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.2",
    "@types/streamifier": "^0.1.2",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.3",
    "argon2": "^0.44.0",
    "axios": "^1.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cloudinary": "^2.11.0",
    "colorette": "^2.0.20",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.3",
    "ioredis": "^5.4.2",
    "joi": "^17.13.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.10",
    "nx": "^21.2.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "streamifier": "^0.1.1",
    "stripe": "^22.6.2",
    "winston": "^3.17.0"
  },
  "overrides": {
    "uuid": "^9.0.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@nx/js": "^21.2.2",
    "@nx/node": "^21.2.2",
    "@types/jest": "^29.5.14",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "prisma": "^6.15.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "6.0.3"
  }
}
