generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostType {
  EVENT
  SOCIAL_EVENT
  ANNOUNCEMENT
  NEWS
}

enum PostStatus {
  DRAFT
  PENDING
  APPROVED
  PUBLISHED
  REJECTED
}

enum EventsRole {
  USER
  CONTENT_MANAGER
  ADMIN
}

model Post {
  id               String      @id @default(uuid())
  type             PostType
  status           PostStatus  @default(DRAFT)
  title            String
  excerpt          String?     // Short description
  content          String      // Rich text full content
  coverImage       String?
  authorId         String
  publishDate      DateTime?
  
  // Event specific fields
  slug             String?     @unique
  eventDate        DateTime?
  endEventDate     DateTime?
  startTime        String?
  endTime          String?
  timezone         String?     @default("UTC")
  location         String?     // Physical or Link
  locationAddress  String?
  locationMapUrl   String?
  externalLink     String?
  hostName         String?     // For social events
  privacy          String?     // public, link_only, password
  templateId       String?     // For social event themes
  
  // New: Relations for full management
  tickets          Ticket[]
  registrations    Registration[]
  sessions         Session[]
  sponsors         Sponsor[]
  rsvps            RSVP[]

  // Feedback from admin when rejected
  rejectionReason  String?

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status])
  @@index([type])
}

model Ticket {
  id               String   @id @default(uuid())
  eventId          String
  event            Post     @relation(fields: [eventId], references: [id])
  name             String
  price            Float
  quantity         Int      @default(100)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  registrations    Registration[]
}

model Registration {
  id               String   @id @default(uuid())
  eventId          String
  event            Post     @relation(fields: [eventId], references: [id])
  userId           String?  // Firebase UID if logged in
  attendeeName     String
  attendeeEmail    String
  ticketId         String?
  ticket           Ticket?  @relation(fields: [ticketId], references: [id])
  totalPaid        Float    @default(0)
  paymentStatus    String   @default("paid") // paid, pending, failed
  qrCodeValue      String?
  isCheckedIn      Boolean  @default(false)
  checkedInAt      DateTime?
  createdAt        DateTime @default(now())
}

model Session {
  id               String   @id @default(uuid())
  eventId          String
  event            Post     @relation(fields: [eventId], references: [id])
  title            String
  speakerName      String?
  startTime        DateTime
  endTime          DateTime
  createdAt        DateTime @default(now())
}

model Sponsor {
  id               String   @id @default(uuid())
  eventId          String
  event            Post     @relation(fields: [eventId], references: [id])
  name             String
  tier             String?  // e.g., Gold, Silver, Bronze
  logoUrl          String?
  createdAt        DateTime @default(now())
}

model RSVP {
  id               String   @id @default(uuid())
  eventId          String
  event            Post     @relation(fields: [eventId], references: [id])
  guestName        String
  guestEmail       String
  response         String   // yes, no, maybe
  plusOneName      String?
  mealPreference   String?
  notes            String?
  createdAt        DateTime @default(now())
}

model PromotionRequest {
  id                 String   @id @default(uuid())
  companyName        String
  contactPerson      String
  email              String
  phoneNumber        String?
  organization       String?
  event_type         String?
  estimatedAttendees String?
  preferredDate      DateTime?
  location           String?
  type               PostType @default(EVENT)
  message            String   // Detailed goals
  status             String   @default("PENDING") // PENDING, REVIEWED, CONVERTED
  userId             String?  // Firebase UID of the submitter
  createdAt          DateTime @default(now())
}

model EventsProfile {
  id               String     @id // Firebase UID
  role             EventsRole @default(USER)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model MessageDispatch {
  id              String   @id @default(uuid())
  eventId         String
  subject         String
  recipientCount  Int
  sentCount       Int
  createdBy       String
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([createdBy])
}

model PortfolioMedia {
  id           String   @id @default(uuid())
  portal       String   // professional, social
  category     String
  title        String
  description  String?
  mediaType    String   // image, video
  mediaUrl     String
  thumbnailUrl String?
  sortOrder    Int      @default(0)
  createdBy    String
  createdAt    DateTime @default(now())
}
