// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            String   @id @default(uuid())
  title         String
  location      String
  yearGc        String?  @map("year_gc")
  systemType    String?  @map("system_type")
  capacityM3    Float?   @map("capacity_m3")
  tags          String[]
  summary       String?
  description   String?
  photos        String[]
  partnerNames  String[] @map("partner_names")
  displayOrder  Int      @default(0) @map("display_order")
  isPublished   Boolean  @default(true) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("projects")
}

model Partner {
  id           String   @id @default(uuid())
  orgName      String   @map("org_name")
  orgFullName  String?  @map("org_full_name")
  role         String?
  category     String?
  logoUrl      String?  @map("logo_url")
  websiteUrl   String?  @map("website_url")
  displayOrder Int      @default(0) @map("display_order")
  isPublished  Boolean  @default(true) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("partners")
}

model Contact {
  id              String   @id @default(uuid())
  name            String
  organization    String?
  email           String
  phone           String?
  country         String?
  serviceInterest String?  @map("service_interest")
  message         String
  sourcePage      String?  @map("source_page")
  isRead          Boolean  @default(false) @map("is_read")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("contacts")
}

model Donation {
  id        String   @id @default(uuid())
  donorName String   @map("donor_name")
  email     String
  country   String?
  amount    Float
  currency  String   @default("USD")
  message   String?
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("donations")
}

model StoryChapter {
  id          String   @id @default(uuid())
  year        Int?
  projectName String?  @map("project_name")
  storyText   String   @map("story_text")
  photos      String[]
  captions    String[]
  tags        String[]
  orderIndex  Int      @default(0) @map("order_index")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("story_chapters")
}

model TeamMember {
  id           String   @id @default(uuid())
  name         String
  role         String
  bio          String?
  photoUrl     String?  @map("photo_url")
  displayOrder Int      @default(0) @map("display_order")
  isPublished  Boolean  @default(true) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("team_members")
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model User {
  id        String   @id // Firebase UID
  email     String   @unique
  firstname String?
  lastname  String?
  role      AlikowashRole @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

enum AlikowashRole {
  USER
  MANAGER
  ADMIN
}
