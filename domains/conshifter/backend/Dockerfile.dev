# Stage 1: Development setup
FROM node:22

WORKDIR /usr/src/app

# Copy only dependency files first for better caching
COPY package*.json ./

# Install all dependencies (include dev deps for live reload, etc.)
RUN npm install

# Copy the rest of the source code
COPY . .

# Generate Prisma client (skip build for dev)
RUN npx prisma generate

# Expose the app port
EXPOSE 3000

# Use a development-friendly command
CMD ["sh", "-c", "npx prisma migrate dev && npm run start:dev"]