generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id                     Int              @id @default(autoincrement())
  title                  String
  description            String
  responsibilities       String[]
  qualifications         String[]
  preferredQualifications String[]
  benefits               String[]
  salaryMin              Int?
  salaryMax              Int?
  currency               String           @default("USD")
  location               String           @default("Remote")
  region                 String?
  workMode               WorkMode         @default(REMOTE)
  employmentType         EmploymentType   @default(FULL_TIME)
  level                  String?
  status                 JobStatus        @default(OPEN)
  category               String?
  department             String?
  tags                   String[]
  featured               Boolean          @default(false)
  urgent                 Boolean          @default(false)
  postedBy               String           // userId from Auth service
  ventureId              String?
  companyId              String?
  ventureName            String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  applications           JobApplication[]
  venture                Venture?         @relation(fields: [ventureId], references: [id])
  company                Company?         @relation(fields: [companyId], references: [id])
}

model Venture {
  id          String   @id
  name        String
  slug        String   @unique
  description String
  tagline     String?
  accentColor String?
  icon        String?
  sector      String?
  jobs        Job[]
}

model Company {
  id              String   @id
  name            String
  slug            String   @unique
  description     String
  sector          String?
  size            String?
  headquarters    String?
  website         String?
  verified        Boolean  @default(false)
  logoPlaceholder String?
  jobs            Job[]
}

model JobApplication {
  id                Int      @id @default(autoincrement())
  jobId             Int
  userId            String   // applicant userId from Auth service
  fullName          String
  email             String
  phone             String?
  location          String?
  linkedInUrl       String?
  portfolioUrl      String?
  yearsOfExperience Int?
  skills            String[]          @default([])
  coverLetter       String?
  resumeUrl         String
  salaryExpectation Int?
  salaryCurrency    String?
  salaryNegotiable  Boolean?
  startDate         String?
  workAuthorized    Boolean?
  notes             String?
  adminNotes        String?
  status            ApplicationStatus @default(SUBMITTED)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  job               Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model CommunityMember {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String?
  interests String[]
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Content {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  body      String?
  authorId  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  FELLOWSHIP
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FELLOWSHIP
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  RESUME_SCREENING
  EVALUATION_PASSED
  INTERVIEWING
  OFFER
  NO_OFFER
  WITHDRAWN
}
