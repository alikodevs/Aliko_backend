// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContechProfile {
  id              Int         @id @default(autoincrement())
  userId          String      @unique
  role            ContechRole @default(CLIENT)
  hasSelectedRole Boolean     @default(false)
  bio             String?
  companyName     String?
  company         String?
  phone           String?
  projects        String[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Project {
  id           Int            @id @default(autoincrement())
  name         String
  manager      String
  startDate    DateTime?
  endDate      DateTime?
  
  // Custom fields kept for functionality
  subtitle     String?
  inspectorId  String?
  contractorId String?
  site         String?
  description  String?
  clientId     String?
  photos       String[]
  status       String?        @default("PLANNED")
  progress     Float?         @default(0.0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdBy    String?
  updatedBy    String?
  metadata     Json?

  // Relations
  tasks         Task[]
  contracts     Contract[]
  inspections   Inspection[]
  clientReports ClientReport[]
  milestones    Milestone[]
  comments      Comment[]
  updates       ProjectUpdate[]
  documents     ProjectDocument[]

  @@index([manager])
  @@index([contractorId])
  @@index([clientId])
}

model ProjectUpdate {
  id          Int      @id @default(autoincrement())
  projectId   Int
  authorId    String
  text        String
  photos      String[]
  tags        String[]
  isVisibleToClient Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  Project     Project  @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([authorId])
}

model ProjectDocument {
  id              Int      @id @default(autoincrement())
  projectId       Int
  title           String
  url             String
  fileType        String?  // PDF, IMAGE, DOC
  uploadedBy      String
  isVisibleToClient Boolean @default(false)
  createdAt       DateTime @default(now())
  
  Project         Project  @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model Task {
  id          Int     @id @default(autoincrement())
  projectId   Int
  description String
  status      String
  deadline    DateTime
  assignedTo  String?
  progress    Float?  @default(0.0)
  actualHours Int?
  isVisibleToClient Boolean @default(false)
  
  // Relations
  Project     Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model Contract {
  id           Int     @id @default(autoincrement())
  projectId    Int
  title        String?
  contractFile String
  status       String  @default("DRAFT")
  value        Float?  @default(0.0)
  startDate    DateTime?
  endDate      DateTime?
  changeOrders Json    @default("[]")
  
  // Relations
  Project      Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model Inspection {
  id          Int      @id @default(autoincrement())
  projectId   Int
  title       String?
  inspector   String?
  checklist   Json     @default("[]")
  photos      Json     @default("[]")
  status      String   @default("PENDING")
  isVisibleToClient Boolean @default(false)
  
  // Relations
  Project     Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
}



model ClientReport {
  id          Int      @id @default(autoincrement())
  projectId   Int
  summary     String
  KPIs        Json
  generatedAt DateTime @default(now())
  
  // Relations
  Project     Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  projectId Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  // Relations
  Project   Project  @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model Milestone {
  id          Int               @id @default(autoincrement())
  projectId   Int
  title       String
  description String?
  status      MilestoneStatus   @default(PENDING)
  dueDate     DateTime?
  progress    Float?            @default(0.0)
  isVisibleToClient Boolean @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  
  Project     Project           @relation(fields: [projectId], references: [id])

  @@index([projectId])
}



enum MilestoneStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  DELAYED
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  COMPLETED
  BLOCKED
  TODO
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ContractStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  AMENDED
  TERMINATED
}

enum InspectionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SCHEDULED
}

enum ChecklistItemStatus {
  PASS
  FAIL
  PENDING
  NOT_APPLICABLE
}

enum ContechRole {
  ADMIN
  CONTRACTOR
  CLIENT
  PROJECT_MANAGER
  USER
}
