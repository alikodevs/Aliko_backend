generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
  output        = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  ADMIN @map("admin")
}

enum BookingStatus {
  PENDING    @map("pending")
  CONFIRMED  @map("confirmed")
  CANCELLED  @map("cancelled")
  COMPLETED  @map("completed")
  NO_SHOW    @map("no_show")
}

enum ApplicationStatus {
  DRAFT        @map("draft")
  SUBMITTED    @map("submitted")
  UNDER_REVIEW @map("under_review")
  APPROVED     @map("approved")
  REJECTED     @map("rejected")
  WAITLISTED   @map("waitlisted")
}

enum ResourceType {
  ARTICLE   @map("article")
  GUIDE     @map("guide")
  CHECKLIST @map("checklist")
  TEMPLATE  @map("template")
}

enum ConsultationType {
  BUSINESS @map("business")
  CAREER   @map("career")
  TRAVEL   @map("travel")
}

model Profile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id")
  fullName  String?  @map("full_name")
  email     String?
  phone     String?
  avatarUrl      String?  @map("avatar_url")
  bio            String?
  university     String?
  country        String?
  educationLevel String?  @map("education_level")
  specialization String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("profiles")
}

model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id")
  role      AppRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, role])
  @@map("user_roles")
}

model AvailabilityRule {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dayOfWeek            Int              @map("day_of_week")
  startTime            DateTime         @map("start_time") @db.Time
  endTime              DateTime         @map("end_time") @db.Time
  slotDurationMinutes Int              @default(30) @map("slot_duration_minutes")
  bufferMinutes        Int              @default(10) @map("buffer_minutes")
  consultationType     ConsultationType @default(BUSINESS) @map("consultation_type")
  isActive             Boolean          @default(true) @map("is_active")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("availability_rules")
}

model TimeBlock {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String   @default("Blocked")
  startDatetime DateTime @map("start_datetime") @db.Timestamptz
  endDatetime   DateTime @map("end_datetime") @db.Timestamptz
  reason        String?
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("time_blocks")
}

model Booking {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String?          @map("user_id")
  bookingCode      String           @unique @map("booking_code")
  fullName         String           @map("full_name")
  email            String
  phone            String?
  consultationType ConsultationType @map("consultation_type")
  bookingDate      DateTime         @map("booking_date") @db.Date
  startTime        DateTime         @map("start_time") @db.Time
  endTime          DateTime         @map("end_time") @db.Time
  status           BookingStatus    @default(PENDING)
  notes            String?
  adminNotes       String?          @map("admin_notes")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("bookings")
}

model Application {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String?           @map("user_id")
  applicationCode  String            @unique @map("application_code")
  fullName         String            @map("full_name")
  email            String
  phone            String?
  consultationType ConsultationType  @map("consultation_type")
  status           ApplicationStatus @default(SUBMITTED)
  formData         Json              @default("{}") @map("form_data")
  adminNotes       String?           @map("admin_notes")
  reviewedBy       String?           @map("reviewed_by")
  reviewedAt       DateTime?         @map("reviewed_at") @db.Timestamptz
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  logs      ApplicationStatusLog[]
  documents ApplicationDocument[]

  @@map("applications")
}

model ApplicationStatusLog {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String            @map("application_id") @db.Uuid
  oldStatus     ApplicationStatus? @map("old_status")
  newStatus     ApplicationStatus  @map("new_status")
  changedBy     String?           @map("changed_by")
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_status_log")
}

model ApplicationDocument {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  fileName      String   @map("file_name")
  filePath      String   @map("file_path")
  fileSize      Int?     @map("file_size")
  mimeType      String?  @map("mime_type")
  uploadedBy    String?  @map("uploaded_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_documents")
}

model Page {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String   @unique
  title           String
  content         Json     @default("[]")
  isPublished     Boolean  @default(false) @map("is_published")
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("pages")
}

model Resource {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String           @unique
  title            String
  description      String?
  content          Json             @default("[]")
  resourceType     ResourceType     @default(ARTICLE) @map("resource_type")
  thumbnailUrl     String?          @map("thumbnail_url")
  isPublished      Boolean          @default(false) @map("is_published")
  consultationType ConsultationType? @map("consultation_type")
  createdBy        String?          @map("created_by")
  fileUrl          String?          @map("file_url")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("resources")
}

model Webinar {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String    @unique
  title           String
  description     String?
  webinarUrl      String?   @map("webinar_url")
  thumbnailUrl    String?   @map("thumbnail_url")
  scheduledAt     DateTime? @map("scheduled_at") @db.Timestamptz
  durationMinutes Int?      @map("duration_minutes")
  isPublished     Boolean   @default(false) @map("is_published")
  isFree          Boolean   @default(true) @map("is_free")
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  registrations   WebinarRegistration[]

  @@map("webinars")
}

model Testimonial {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorName       String           @map("author_name")
  authorRole       String?          @map("author_role")
  authorImageUrl   String?          @map("author_image_url")
  quote            String
  consultationType ConsultationType? @map("consultation_type")
  rating           Int?
  isPublished      Boolean          @default(false) @map("is_published")
  displayOrder     Int              @default(0) @map("display_order")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("testimonials")
}

model WebinarRegistration {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webinarId String   @map("webinar_id") @db.Uuid
  name      String
  email     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  webinar   Webinar  @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@map("webinar_registrations")
}

model ContactSubmission {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName         String           @map("full_name")
  email            String
  phone            String?
  subject          String
  message          String
  consultationType ConsultationType? @map("consultation_type")
  isRead           Boolean          @default(false) @map("is_read")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@map("contact_submissions")
}
