{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "generated/**/*",
        "watchAssets": true
      }
    ],
    "builder": "tsc",
    "webpack": false
  }
}
