# Common & Gateway
NODE_ENV=development
API_GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
ACADEMY_SERVICE_PORT=3002
CONTECH_SERVICE_PORT=3003
EVENTS_SERVICE_PORT=3004
CAREERS_SERVICE_PORT=3005
FINANCIAL_SERVICE_PORT=3006
COMMUNICATION_SERVICE_PORT=3007
STORAGE_SERVICE_PORT=3008

# Auth & Peer Security
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d
INTERNAL_SERVICE_SECRET=aliko-internal-secret-change-in-production

# PostgreSQL Multi-Database Connections
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/user_db?schema=public"
DATABASE_URL_USER="postgresql://postgres:postgres@localhost:5432/user_db?schema=public"
DATABASE_URL_ACADEMY="postgresql://postgres:postgres@localhost:5432/academy_db?schema=public"
DATABASE_URL_CONTECH="postgresql://postgres:postgres@localhost:5432/contech_db?schema=public"
DATABASE_URL_EVENTS="postgresql://postgres:postgres@localhost:5432/events_db?schema=public"
DATABASE_URL_CAREERS="postgresql://postgres:postgres@localhost:5432/careers_db?schema=public"
DATABASE_URL_FINANCIAL="postgresql://postgres:postgres@localhost:5432/aliko_financial_db?schema=public"
DATABASE_URL_COMMUNICATION="postgresql://postgres:postgres@localhost:5432/communication_db?schema=public"

# Redis Cache & PubSub
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ Message Broker
RABBITMQ_URI="amqp://guest:guest@localhost:5672"

# Storage
LOCAL_UPLOAD_DIR="./uploads"

# Mailer (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="noreply@alikohub.com"

# Payment Gateways (Optional)
CHAPA_KEY=""
CHAPA_SECRET=""
STRIPE_KEY=""
STRIPE_SECRET=""
