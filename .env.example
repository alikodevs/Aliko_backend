# Required for docker-compose / VPS
# Never commit real .env files. Use strong unique values in production.
# Local compose publishes Postgres only on 127.0.0.1:5432; VPS publishes no DB ports.
DB_USER=alikohub
DB_PASSWORD=replace-with-strong-password
DB_NAME=alikohub_db
JWT_SECRET=replace-with-long-random-secret

RABBITMQ_USER=alikohub
RABBITMQ_PASS=replace-with-strong-password
# Do not use guest/guest outside a locked-down local sandbox

# Optional integrations
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@alikohub.com
# Path inside containers (compose mounts ./firebase-service-account.json here).
# Download from Firebase Console → Project settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json
CHAPA_KEY=
CHAPA_SECRET=
STRIPE_KEY=
STRIPE_SECRET=
